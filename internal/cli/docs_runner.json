{
  "id": "trail-docs",
  "display_name": "Doc Staleness Eval",
  "enabled": true,
  "scope": "trail",
  "runtime": {
    "kind": "prompt_runner",
    "agent": "claude",
    "timeout_ms": 600000,
    "sandbox": {
      "base_template": "claude",
      "repo_token": "read"
    }
  },
  "automation": {
    "kind": "trail_prompt"
  },
  "prompt": {
    "template": ""
  },
  "select": {
    "trigger_types": [
      "api",
      "push"
    ]
  },
  "output": {
    "adapter": "last_json_line",
    "result_type": "trail_monitor",
    "trail_monitor": {
      "key": "doc_staleness",
      "label": "Doc staleness",
      "value_type": "percent",
      "polarity": "lower_is_better"
    }
  }
}
